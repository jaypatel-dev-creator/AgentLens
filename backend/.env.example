# Gemini
GOOGLE_API_KEY=your_google_api_key_here

# SigNoz — OpenTelemetry
OTEL_SERVICE_NAME=agentlens
OTLP_ENDPOINT=https://ingest.us2.signoz.cloud:443
SIGNOZ_INGESTION_KEY=your_signoz_ingestion_key_here

# Tavily
TAVILY_API_KEY=your_tavily_api_key_here

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# DB — leave empty for SQLite (local); set Supabase Postgres URL for prod on Render dashboard
DATABASE_URL=
SQLITE_DB_PATH=./data/agentlens.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# RAG — Vector Store
# Leave PINECONE_API_KEY empty for local (ChromaDB auto-used)
# Set on Render dashboard for prod
CHROMA_PATH=./data/chroma
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentlens-rag

# Auth — JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080